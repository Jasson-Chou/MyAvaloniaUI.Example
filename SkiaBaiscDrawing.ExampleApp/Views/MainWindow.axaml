<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SkiaBasicDrawing.ExampleApp.ViewModels"
        xmlns:usrCtrl="using:SkiaBasicDrawing.ExampleApp.Views.UserCtrl"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="SkiaBasicDrawing.ExampleApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="SkiaBasicDrawing.ExampleApp">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>
    <Window.Styles>
        <Style Selector="NumericUpDown.primary">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2 0.4"/>
            <Setter Property="Width" Value="150"/>
            
        </Style>

        <Style Selector="TextBlock.primary">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2 0.4"/>
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Margin" Value="2 1.5"/>
        </Style>

    </Window.Styles>
    <Grid RowDefinitions="*, auto, auto" ColumnDefinitions="*, auto, auto">
        
        <usrCtrl:SkiaDrawWaveformScopeUsrCtrl x:Name="DrawLineControl" 
                                              XOffset="{Binding #xOffsetScrollBar.Value}"
                                              YOffset="{Binding #yOffsetScrollBar.Value}"
                                              XScale="{Binding #xScaleSlider.Value}"
                                              YScale="{Binding #yScaleSlider.Value}"
                                              MaxValue="{Binding UserSetting.MaxValue}"
                                              MinValue="{Binding UserSetting.MinValue}"
                                              PointCount="{Binding UserSetting.PointCount}"
                                              Items="{Binding Items}"
                                              />

        <ScrollBar x:Name="xOffsetScrollBar" Grid.Row="1" Orientation="Horizontal" Minimum="0.0" Maximum="{Binding #DrawLineControl.MaxXOffset}" Value="0.0" />
        <ScrollBar x:Name="yOffsetScrollBar" Grid.Column="1" Orientation="Vertical" Minimum="0.0" Maximum="{Binding #DrawLineControl.MaxYOffset}" Value="0.0" />
        

        <Grid Grid.Row="0" Grid.Column="2" Grid.RowSpan="2"
              ColumnDefinitions="auto, auto" RowDefinitions="auto, auto, auto, auto, auto, auto, auto, auto, auto, auto, auto,*">
            <Grid.Styles>
                <Style Selector="TextBlock.align">
                    <Setter Property="Grid.Column" Value="0"/>
                </Style>
            </Grid.Styles>

            <TextBlock Text="X Scale:" Grid.Row="0" Classes="primary align"/>
            <StackPanel                Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                <Slider x:Name="xScaleSlider" Width="160" Minimum="1.0" Maximum="100" Value="1.0" />
                <NumericUpDown Value="{Binding #xScaleSlider.Value}" Classes="primary" FormatString="F2"/>
            </StackPanel>

            <TextBlock Text="Y Scale:" Grid.Row="1" Classes="primary align"/>
            <StackPanel                Grid.Row="1" Grid.Column="2" Orientation="Horizontal">
                <Slider x:Name="yScaleSlider" Width="160" Minimum="1.0" Maximum="100" Value="1.0" />
                <NumericUpDown Value="{Binding #yScaleSlider.Value}" Classes="primary" FormatString="F2"/>
            </StackPanel>

            <TextBlock Text="FPS:" Grid.Row="2" Classes="primary align"/>
            <NumericUpDown x:Name="fpsNumericUpDown" HorizontalAlignment="Stretch" Grid.Row="2" Grid.Column="2" Minimum="1" Maximum="144" Value="{Binding UserSetting.Fps}" Classes="primary" FormatString="F0"/>

            <TextBlock Text="Points:" Grid.Row="3" Classes="primary align"/>
            <NumericUpDown x:Name="pointsNumericUpDown" HorizontalAlignment="Stretch" Grid.Row="3" Grid.Column="2" Minimum="0" Maximum="1000000" Value="{Binding UserSetting.PointCount}" Classes="primary" FormatString="F0"/>
            
            <TextBlock Text="Freq:" Grid.Row="4" Classes="primary align"/>
            <NumericUpDown x:Name="freqNumericUpDown" HorizontalAlignment="Stretch" Grid.Row="4" Grid.Column="2" Minimum="1" Maximum="1000000" Value="{Binding UserSetting.Frequency}" Classes="primary"/>
            
            <TextBlock Text="Fs:" Grid.Row="5" Classes="primary align"/>
            <NumericUpDown x:Name="fsNumericUpDown" HorizontalAlignment="Stretch" Grid.Row="5" Grid.Column="2" Minimum="1" Maximum="1000000" Value="{Binding UserSetting.SampleRate}" Classes="primary"/>
            
            <TextBlock Text="Amplitude:" Grid.Row="6" Classes="primary align"/>
            <NumericUpDown x:Name="amplitudeNumericUpDown" HorizontalAlignment="Stretch" Grid.Row="6" Grid.Column="2" Value="{Binding UserSetting.Amplitude}" Classes="primary" FormatString="F0"/>
            
            <TextBlock Text="Auto Max/Min Scale:" Grid.Row="7" Classes="primary align"/>
            <CheckBox x:Name="autoScaleCheckBox" HorizontalAlignment="Stretch" Grid.Row="7" Grid.Column="2" IsChecked="{Binding UserSetting.AutoScale}" Classes="primary"/>
            
            <TextBlock Text="Max Value:" Grid.Row="8" Classes="primary align"/>
            <NumericUpDown x:Name="maxValueNumericUpDown" HorizontalAlignment="Stretch" Grid.Row="8" Grid.Column="2" Value="{Binding UserSetting.MaxValue}" Classes="primary" FormatString="F0"/>
            
            <TextBlock Text="Min Value:" Grid.Row="9" Classes="primary align"/>
            <NumericUpDown x:Name="minValueNumericUpDown" HorizontalAlignment="Stretch" Grid.Row="9" Grid.Column="2" Value="{Binding UserSetting.MinValue}" Classes="primary" FormatString="F0"/>
            

            <StackPanel                Grid.Row="10" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="runButton" Content="Run" Width="100" HorizontalContentAlignment="Center" Command="{Binding RunCommand}" Classes="primary"/>
                <Button x:Name="stopButton" Content="Stop" Width="100" HorizontalContentAlignment="Center" Command="{Binding StopCommand}" Classes="primary"/>
            </StackPanel>
            
        </Grid>
        
    </Grid>

</Window>
